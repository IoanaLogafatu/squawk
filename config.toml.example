# config.toml.example
#
# Copy this file to config.toml and edit it for your setup.
# config.toml is in .gitignore — this file is the one kept in version control.
#

# ---------------------------------------------------------------------------
# Squawk system
# ---------------------------------------------------------------------------
[squawk]
data_dir = "data"    # working datasets and state files


# ---------------------------------------------------------------------------
# User details
# ---------------------------------------------------------------------------
[observer]
latitude  = 53.7778    # decimal degrees, positive = North
longitude = -1.5721    # decimal degrees, negative = West


# ---------------------------------------------------------------------------
# Ingestors
# ---------------------------------------------------------------------------

[ingestors.concorde]
enabled = true
modules = ["altitude_band"]                 # no tar1090_db: concorde fabricates a complete
                                            # airframe, so a lookup would miss and write nothing.
                                            # altitude_band is source-independent — a pure function
                                            # of a field every source provides.

[ingestors.personal_adsb]
enabled               = false
modules               = ["tar1090_db", "altitude_band"]   # enrichment applied to all aircraft entering storage
receivers             = [
    { name = "receiver-one", url = "http://receiver-one.local/tar1090/data/aircraft.json" },
    { name = "receiver-two", url = "http://receiver-two.local/tar1090/data/aircraft.json" },
]
poll_interval_seconds = 5
timeout_seconds       = 3


# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

[storage]
backend = "disk_drive"


# ---------------------------------------------------------------------------
# Processors (Independent Chains)
# ---------------------------------------------------------------------------

# --- Row 1: Altitude Bands ---

# One chain covers every band: band_closest picks the nearest aircraft in each,
# and the panel's `list` layout places them by band letter. It runs before
# adsbdb deliberately — at most one lookup per band per cycle instead of one
# per aircraft in range.
[processors.panel_one]
enabled               = true
poll_interval_seconds = 5
modules               = ["band_closest", "adsbdb"]
display               = "http"

# --- Row 2: Special Targets ---

[processors.closest_overhead]
enabled               = true
poll_interval_seconds = 5
modules               = ["near_distance", "closest_filter", "adsbdb"]
display               = "http"

[processors.watchlist]
enabled               = true
poll_interval_seconds = 5
modules               = ["registration_filter", "closest_filter", "adsbdb"]
display               = "http"

[processors.descending]
enabled               = true
poll_interval_seconds = 5
modules               = ["descending_filter", "closest_filter", "adsbdb"]
display               = "http"

[processors.climbing]
enabled               = true
poll_interval_seconds = 5
modules               = ["climbing_filter", "closest_filter", "adsbdb"]
display               = "http"


# --- Notifications ---

[processors.pushover]
enabled               = false
poll_interval_seconds = 5
modules               = ["ground_distance_filter", "registration_filter", "adsbdb"]
display               = "pushover"


# ---------------------------------------------------------------------------
# Modules
# ---------------------------------------------------------------------------

[modules.near_distance]
type         = "ground_distance_filter"
max_distance = 10
unit         = "nm"

[modules.descending_filter]
type = "vertical_rate_filter"
mode = "descending"

[modules.climbing_filter]
type = "vertical_rate_filter"
mode = "climbing"

[modules.registration_filter]
registrations = [
    "G-RUKG",
    "G-RUKC",
    "G-UJEA",
    "G-LMTE",
    "G-EZOK",
]

[modules.ground_distance_filter]
max_distance = 25           # Maximum ground distance (optional)
min_distance = 0            # Minimum ground distance (optional)
unit         = "miles"      # Distance unit: "miles", "km", or "nm" (default "nm")

# Flight-level bands, assigned at ingest. The letters are identity; the
# FL strings a panel shows are display copy. Changing these edges changes
# the meaning of every letter across the installation.
# N edges give N+1 bands lettered from "A": below 10k = A, 10k-20k = B,
# 20k-30k = C, 30k and above = D. Each edge must be a positive multiple
# of 100 and strictly ascending; there is no default.
[modules.altitude_band]
edges = [10000, 20000, 30000]

# Modules referenced above that take no options still need a block —
# empty is fine; see docs/modules-guide.md.
[modules.closest_filter]
[modules.band_closest]

[modules.tar1090_db]
# refresh_days = 30   # Max age (days) of the cached CSV before it's
                       # redownloaded. Checked hourly, not just at startup.
                       # Optional; 30 is the default.

[modules.adsbdb]
# Airframe and route are looked up separately, so an unknown hex no longer
# costs you the route. Caches live under <data_dir>/modules/adsbdb/ in
# aircraft/ (7-day TTL) and route/ (1-hour TTL).
# log_unresolved = false   # Append a JSON line per route adsbdb could not
                           # resolve to modules/adsbdb/route/unresolved.jsonl.
                           # Diagnostic only; hand-read, never rotated.


# ---------------------------------------------------------------------------
# Data sources
# ---------------------------------------------------------------------------
# External datasets shared between modules: one download, one freshness check,
# one instance, however many modules name it. Files live under
# <data_dir>/data_sources/<name>/. See docs/data-sources-guide.md.
#
# vrs_standing_data ships and works today: the whole VRS standing-data repo —
# aircraft, airlines, airports, code-blocks, countries, model-type,
# registration-prefixes, routes — into one SQLite file, refreshed weekly.
# vrs_route (below) is its first real consumer.

[data_sources.vrs]
type         = "vrs_standing_data"
# refresh_days = 7   # default; rebuild when the DB is older than this

[modules.vrs_route]
source = "vrs"
# log_level = "errors"   # "none" | "errors" | "verbose" — default "errors".
                          # Console diagnostics only; separate from the
                          # unresolved-route log this module always writes
                          # to modules/vrs_route/unresolved.jsonl.

# A second module naming source = "vrs" would share the same one download —
# that pooling is the whole point of a data source. e.g.:
#
# [modules.vrs_aircraft]
# source = "vrs"


# ---------------------------------------------------------------------------
# Display
# ---------------------------------------------------------------------------

[display.pushover]
token            = "xxxxxxxxxxxxxxxxxxxxxxxxxx"
user             = "xxxxxxxxxxxxxxxxxxxxxxxxxx"
cooldown_seconds = 7200                       # Cooldown per flight (hex + callsign), defaults to 2 hours


[display.http]
port = 7700                              # HTTP port for the web display

# Panels are keyed by processor chain name. A chain named [processors.low_level]
# is matched to [display.http.panels.low_level]; the block is required.
#
# `slot` is a fixed position in the 4x2 wall and is required — all eight slots
# always render, and one with no chain assigned shows as UNASSIGNED rather than
# closing the gap:
#
#     1  2  3  4
#     5  6  7  8
#
# `title` is optional and falls back to a title-cased chain name.
# `layout` defaults to "card", the single-aircraft view every other panel here
# uses. "list" renders one row per letter in `bands`, top to bottom as written,
# and needs the altitude_band enricher on the ingestors. Rows are placed by each
# aircraft's own band letter: a band with nothing in it is a row of empty space,
# not a missing row. The letters are not checked against
# [modules.altitude_band].edges — a band no aircraft can reach is a permanently
# empty row, which is visible on the wall and says so itself.
[display.http.panels.panel_one]
title  = "Overhead"
slot   = 1
layout = "list"
bands  = ["D", "C", "B", "A"]

[display.http.panels.closest_overhead]
title = "Nearby (< 10 nm)"
slot  = 5

[display.http.panels.watchlist]
title = "Watchlist Target"
slot  = 6

[display.http.panels.descending]
title = "Inbound / Descending"
slot  = 7

[display.http.panels.climbing]
title = "Outbound / Climbing"
slot  = 8

[display.epaper]
port               = 7700   # HTTP port for the PNG preview page
full_refresh_every = 600    # cycles between full e-paper refreshes
invert             = false  # true rotates 180° (power lead at top)
