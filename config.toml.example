# config.toml.example
#
# Copy this file to config.toml and edit it for your setup.
# config.toml is in .gitignore — this file is the one kept in version control.
#

# ---------------------------------------------------------------------------
# Squawk system
# ---------------------------------------------------------------------------
[squawk]
data_dir = "data"    # working datasets and state files


# ---------------------------------------------------------------------------
# User details
# ---------------------------------------------------------------------------
[observer]
latitude  = 53.7778    # decimal degrees, positive = North
longitude = -1.5721    # decimal degrees, negative = West


# ---------------------------------------------------------------------------
# Ingestors
# ---------------------------------------------------------------------------

[ingestors.concorde]
enabled = true

[ingestors.personal_adsb]
enabled               = false
modules               = ["tar1090_db"]      # enrichment applied to all aircraft entering storage
receivers             = [
    { name = "receiver-one", url = "http://receiver-one.local/tar1090/data/aircraft.json" },
    { name = "receiver-two", url = "http://receiver-two.local/tar1090/data/aircraft.json" },
]
poll_interval_seconds = 5
timeout_seconds       = 3


# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

[storage]
backend = "disk_drive"


# ---------------------------------------------------------------------------
# Processors (Independent Chains)
# ---------------------------------------------------------------------------

# --- Row 1: Altitude Bands ---

[processors.low_level]
enabled               = true
poll_interval_seconds = 5
modules               = ["low_altitude", "closest_filter", "adsbdb"]
display               = "http"

[processors.mid_level]
enabled               = true
poll_interval_seconds = 5
modules               = ["mid_altitude", "closest_filter", "adsbdb"]
display               = "http"

[processors.upper_level]
enabled               = true
poll_interval_seconds = 5
modules               = ["upper_altitude", "closest_filter", "adsbdb"]
display               = "http"

[processors.high_cruise]
enabled               = true
poll_interval_seconds = 5
modules               = ["high_altitude", "closest_filter", "adsbdb"]
display               = "http"

# --- Row 2: Special Targets ---

[processors.closest_overhead]
enabled               = true
poll_interval_seconds = 5
modules               = ["near_distance", "closest_filter", "adsbdb"]
display               = "http"

[processors.watchlist]
enabled               = true
poll_interval_seconds = 5
modules               = ["registration_filter", "closest_filter", "adsbdb"]
display               = "http"

[processors.descending]
enabled               = true
poll_interval_seconds = 5
modules               = ["descending_filter", "closest_filter", "adsbdb"]
display               = "http"

[processors.climbing]
enabled               = true
poll_interval_seconds = 5
modules               = ["climbing_filter", "closest_filter", "adsbdb"]
display               = "http"


# --- Notifications ---

[processors.pushover]
enabled               = false
poll_interval_seconds = 5
modules               = ["ground_distance_filter", "registration_filter", "adsbdb"]
display               = "pushover"


# ---------------------------------------------------------------------------
# Modules
# ---------------------------------------------------------------------------

[modules.low_altitude]
type  = "altitude_filter"
below = 5000

[modules.mid_altitude]
type  = "altitude_filter"
above = 5000
below = 15000

[modules.upper_altitude]
type  = "altitude_filter"
above = 15000
below = 25000

[modules.high_altitude]
type  = "altitude_filter"
above = 25000

[modules.near_distance]
type         = "ground_distance_filter"
max_distance = 10
unit         = "nm"

[modules.descending_filter]
type = "vertical_rate_filter"
mode = "descending"

[modules.climbing_filter]
type = "vertical_rate_filter"
mode = "climbing"

[modules.registration_filter]
registrations = [
    "G-RUKG",
    "G-RUKC",
    "G-UJEA",
    "G-LMTE",
    "G-EZOK",
]



[modules.altitude_filter]
above           = 20000        # Minimum altitude (feet, optional)
below           = 40000        # Maximum altitude (feet, optional)
altitude_source = "alt_baro"   # "alt_baro" or "alt_geom" (default "alt_baro")
fallback        = true         # Fall back to alternate source if chosen source is missing

[modules.ground_distance_filter]
max_distance = 25           # Maximum ground distance (optional)
min_distance = 0            # Minimum ground distance (optional)
unit         = "miles"      # Distance unit: "miles", "km", or "nm" (default "nm")




# ---------------------------------------------------------------------------
# Display
# ---------------------------------------------------------------------------

[display.pushover]
token            = "xxxxxxxxxxxxxxxxxxxxxxxxxx"
user             = "xxxxxxxxxxxxxxxxxxxxxxxxxx"
cooldown_seconds = 7200                       # Cooldown per flight (hex + callsign), defaults to 2 hours


[display.http]
port = 7700                              # HTTP port for the web display

# Panels are keyed by processor chain name. A chain named [processors.low_level]
# is matched to [display.http.panels.low_level]. Missing blocks fall back to a
# title-cased chain name and order 999.
[display.http.panels.low_level]
title = "Approach & Low (< 5k ft)"
order = 1

[display.http.panels.mid_level]
title = "Mid Level (5k–15k ft)"
order = 2

[display.http.panels.upper_level]
title = "Upper Level (15k–25k ft)"
order = 3

[display.http.panels.high_cruise]
title = "High Cruise (> 25k ft)"
order = 4

[display.http.panels.closest_overhead]
title = "Nearby (< 10 nm)"
order = 5

[display.http.panels.watchlist]
title = "Watchlist Target"
order = 6

[display.http.panels.descending]
title = "Inbound / Descending"
order = 7

[display.http.panels.climbing]
title = "Outbound / Climbing"
order = 8

[display.epaper]
port               = 7700   # HTTP port for the PNG preview page
full_refresh_every = 600    # cycles between full e-paper refreshes
invert             = false  # true rotates 180° (power lead at top)
